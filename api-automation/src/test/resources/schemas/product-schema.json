{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["id", "title", "price", "category"],
  "properties": {
    "id": { "type": "integer" },
    "title": { "type": "string", "minLength": 1 },
    "price": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
    "category": { "type": "string" }
  }
}
